VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase Postgres pooler URL used by settlement comparison and worker queue operations.
SUPABASE_DATABASE_URL=
# Required server-only key for every protected Supabase API/server read. Never expose to the browser.
# Server clients prefer RVJP_SUPABASE_SERVICE_ROLE_KEY and treat SUPABASE_SERVICE_ROLE_KEY as a
# compatibility fallback in any environment. They never fall back to anon/public keys.
RVJP_SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth0 (SPA Application)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
