VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase Postgres pooler URL used by settlement comparison and worker queue operations.
SUPABASE_DATABASE_URL=
# Required server-only key for every protected Supabase API/server read. Never expose to the browser.
# Server clients resolve the key in exactly this order: RVJP_DB_ADMIN_TOKEN first (Vercel Preview
# filters env names containing SERVICE_ROLE_KEY), then RVJP_SUPABASE_SERVICE_ROLE_KEY, then
# SUPABASE_SERVICE_ROLE_KEY as compatibility fallbacks. They never fall back to anon/public keys.
RVJP_DB_ADMIN_TOKEN=
RVJP_SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth0 (SPA Application)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=
