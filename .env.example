NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only Supabase Postgres pooler URL used by settlement comparison APIs.
SUPABASE_DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Session cookie signing (required).
# Without it no session can be issued or verified, so login fails closed.
# Generate with: openssl rand -base64 48
SESSION_SECRET=
# Set only while rotating SESSION_SECRET: sessions signed with the previous
# secret stay valid until this is removed.
SESSION_SECRET_PREVIOUS=

# Auth0 (SPA Application)
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_AUDIENCE=

# Auth0 (M2M Application - 프로필 수정 시 필요, 선택)
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
